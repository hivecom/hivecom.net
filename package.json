{
  "name": "hivecom",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "nuxi build --preset github_pages",
    "reset": "npx supabase db reset && node scripts/seed-assets.ts",
    "seed:bulk": "node scripts/seed-bulk.ts",
    "dev": "npx supabase start && NODE_OPTIONS=\"--require ./scripts/suppress-fd-warnings.cjs\" nuxi dev",
    "dev:staging": "NODE_OPTIONS=\"--require ./scripts/suppress-fd-warnings.cjs\" nuxi dev --dotenv .env.production",
    "dev:staging:host": "NODE_OPTIONS=\"--require ./scripts/suppress-fd-warnings.cjs\" nuxi dev --dotenv .env.production --host",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "supabase": "npx supabase",
    "types": "npx supabase gen types typescript --schema public,private > types/database.types.ts && oxfmt -c types/.oxfmtrc.json types/database.types.ts",
    "lint": "eslint . && nuxi typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint:fix": "eslint . --fix && nuxi typecheck --fix && tsc --noEmit -p scripts/tsconfig.json",
    "analyze": "nuxi analyze"
  },
  "dependencies": {
    "@dolanske/v-valid": "^4.0.0",
    "@dolanske/vui": "1.17.2",
    "@iconify-json/material-symbols-light": "^1.2.98",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/tabler": "^1.2.43",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/seo": "^6.0.1",
    "@nuxtjs/sitemap": "^9.1.0",
    "@nuxtjs/supabase": "^2.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@takumi-rs/core": "^2.19.0",
    "@tiptap/extension-details": "^3.32.2",
    "@tiptap/extension-file-handler": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-mathematics": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-youtube": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "@unhead/vue": "^3.4.3",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "@yuta-inoue-ph/nuxt-vcalendar": "^1.1.4",
    "ansi-to-html": "^0.7.2",
    "chart.js": "^4.6.1",
    "chartjs-scale-timestack": "^1.0.1",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "fft.js": "^4.0.4",
    "globe.gl": "^2.46.2",
    "jszip": "^3.10.2",
    "katex": "^0.18.10",
    "luxon": "^3.7.2",
    "marked": "^18.1.3",
    "monaco-editor": "^0.57.0",
    "music-metadata": "^12.3.4",
    "nuxt": "4.6.4",
    "nuxt-og-image": "^7.0.7",
    "nuxt-toc": "^3.0.0",
    "ohash": "^2.0.12",
    "pinia": "^4.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "sass": "^1.107.1",
    "unstorage": "^1.17.6",
    "vue": "^3.5.44",
    "vue-advanced-cropper": "^2.8.9",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@olrtg/emmet-language-server": "^2.8.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "^10.12.0",
    "nuxi": "^4.0.3",
    "oxfmt": "^0.76.0",
    "supabase": "^3.0.0",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    },
    "@vercel/nft": {
      "glob": "^14.0.2"
    },
    "eslint-plugin-format": {
      "tinypool": "^2.2.0"
    },
    "bumpp": {
      "tar": "^7.5.22"
    }
  },
  "//overrides": {
    "rehype-katex > katex": "Security fix (KaTeX trust bypass, fixed in 0.18.2) and keeps markdown math on the same KaTeX as katex.min.css, whose 0.18 classes are prefixed. Remove once rehype-katex depends on katex >=0.18.",
    "micromark-extension-math > katex": "Same as rehype-katex. Remove once micromark-extension-math depends on katex >=0.18.",
    "@vercel/nft > glob": "Security fix (glob AbortSignal bypass, fixed in 14.0.2). @vercel/nft 1.11.0 asks for ^13. Remove once @vercel/nft depends on glob >=14.0.2.",
    "eslint-plugin-format > tinypool": "Security fix (tinypool prototype pollution RCE). eslint-plugin-format 2.0.1 pulls oxfmt 0.35, which pins tinypool 2.1.0. Remove once eslint-plugin-format moves to a newer oxfmt.",
    "bumpp > tar": "Security fix (node-tar path traversal, no 6.x patch). bumpp 9 pulls giget 1, which wants tar 6. Remove once @olrtg/emmet-language-server moves off bumpp 9."
  }
}
