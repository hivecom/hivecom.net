    "remark-math": "^6.0.0",
    "sass": "^1.103.1",
    "unstorage": "^1.17.5",
    "vue": "^3.5.42",
    "vue-advanced-cropper": "^2.8.9",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@olrtg/emmet-language-server": "^2.8.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "nuxi": "^3.37.0",
    "supabase": "^2.116.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
