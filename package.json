{
  "name": "hivecom",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "nuxi build --preset github_pages",
    "reset": "npx supabase db reset && node scripts/seed-assets.ts",
    "dev": "npx supabase start && NODE_OPTIONS=\"--require ./scripts/suppress-fd-warnings.cjs\" nuxi dev",
    "dev:staging": "NODE_OPTIONS=\"--require ./scripts/suppress-fd-warnings.cjs\" nuxi dev --dotenv .env.production",
    "dev:staging:host": "NODE_OPTIONS=\"--require ./scripts/suppress-fd-warnings.cjs\" nuxi dev --dotenv .env.production --host",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "supabase": "npx supabase",
    "types": "npx supabase gen types typescript --local --schema public,private > types/database.types.ts",
    "lint": "eslint . && nuxi typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint:fix": "eslint . --fix && nuxi typecheck --fix && tsc --noEmit -p scripts/tsconfig.json",
    "analyze": "nuxi analyze"
  },
  "dependencies": {
    "@dolanske/v-valid": "^3.0.1",
    "@dolanske/vui": "^1.17.2",
    "@iconify-json/material-symbols-light": "^1.2.90",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/content": "^3.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/seo": "^5.3.14",
    "@nuxtjs/sitemap": "^8.5.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^1.0.2",
    "@takumi-rs/core": "^2.13.5",
    "@tiptap/extension-details": "^3.31.0",
    "@tiptap/extension-file-handler": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-mathematics": "^3.31.0",
    "@tiptap/extension-mention": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/extension-youtube": "^3.31.0",
    "@tiptap/markdown": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/vue-3": "^3.31.0",
    "@unhead/vue": "^3.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "@yuta-inoue-ph/nuxt-vcalendar": "^1.1.4",
    "ansi-to-html": "^0.7.2",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "chartjs-scale-timestack": "^1.0.1",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "fft.js": "^4.0.4",
    "globe.gl": "^2.46.2",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "luxon": "^3.7.2",
    "marked": "^18.0.11",
    "monaco-editor": "^0.56.0",
    "music-metadata": "^11.15.0",
    "nuxt": "4.5.2",
    "nuxt-og-image": "^6.7.8",
